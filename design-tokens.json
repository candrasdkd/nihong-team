{
  "$schema": "https://schemas.example.org/design-tokens-v1",
  "description": "Nihong Jastip Admin — Design Tokens for cross-platform visual consistency (React → Flutter migration reference)",
  "version": "2.0.0",
  "colors": {
    "brand": {
      "navy": "#0B2545",
      "navyLight": "#154574",
      "navyDark": "#071B33",
      "orange": "#F26522",
      "orangeLight": "#FF8A4C",
      "cream": "#FFF4E8",
      "mist": "#EAF0F6"
    },
    "surface": {
      "base": "#F4F6F8",
      "card": "#FFFEFC",
      "border": "#DDE3EA"
    },
    "text": {
      "primary": "#1E293B",
      "secondary": "#64748B",
      "muted": "#94A3B8",
      "inverse": "#FFFFFF"
    },
    "status": {
      "success": "#059669",
      "successBg": "#ECFDF5",
      "warning": "#D97706",
      "warningBg": "#FFFBEB",
      "error": "#DC2626",
      "errorBg": "#FEF2F2",
      "info": "#2563EB",
      "infoBg": "#EFF6FF"
    }
  },
  "borderRadius": {
    "none": "0px",
    "sm": "8px",
    "card": "24px",
    "input": "14px",
    "button": "14px",
    "full": "9999px"
  },
  "spacing": {
    "page": "24px",
    "section": "20px",
    "card": "20px",
    "element": "16px"
  },
  "typography": {
    "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "sizes": {
      "xs": "10px",
      "sm": "12px",
      "base": "14px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px"
    },
    "weights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800",
      "black": "900"
    }
  },
  "shadow": {
    "card": "0 1px 2px rgba(7,27,51,0.04), 0 10px 30px rgba(7,27,51,0.035)",
    "cardHover": "0 16px 38px rgba(7,27,51,0.09), 0 2px 6px rgba(7,27,51,0.05)",
    "modal": "0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1)"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "touchTarget": {
    "minHeight": "44px"
  }
}
